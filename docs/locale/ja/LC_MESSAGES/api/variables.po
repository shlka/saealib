#: ../../api/variables.md:6
msgid "Variables"
msgstr "変数"

#: ../../api/variables.md:16:<autosummary>:1
msgid ":py:obj:`saealib.Variable <saealib.Variable>`"
msgstr "{py:obj}`saealib.Variable <saealib.Variable>`・変数"

#: ../../api/variables.md:16:<autosummary>:1
msgid "Abstract base for a single design variable."
msgstr "1つの設計変数の抽象基底クラスです。"

#: ../../api/variables.md:16:<autosummary>:1
msgid ":py:obj:`saealib.ContinuousVariable <saealib.ContinuousVariable>`"
msgstr "{py:obj}`saealib.ContinuousVariable <saealib.ContinuousVariable>`・変数"

#: ../../api/variables.md:16:<autosummary>:1
msgid "Continuous real-valued variable on ``[lb, ub]``."
msgstr "区間``[lb, ub]``上の連続実数値変数です。"

#: ../../api/variables.md:16:<autosummary>:1
msgid ":py:obj:`saealib.IntegerVariable <saealib.IntegerVariable>`"
msgstr "{py:obj}`saealib.IntegerVariable <saealib.IntegerVariable>`・変数"

#: ../../api/variables.md:16:<autosummary>:1
msgid "Integer-valued variable on ``[lb, ub]`` (both inclusive)."
msgstr "区間``[lb, ub]``（両端を含む）上の整数値変数です。"

#: ../../api/variables.md:16:<autosummary>:1
msgid ":py:obj:`saealib.CategoricalVariable <saealib.CategoricalVariable>`"
msgstr "{py:obj}`saealib.CategoricalVariable <saealib.CategoricalVariable>`・変数"

#: ../../api/variables.md:16:<autosummary>:1
msgid "Categorical variable; stored internally as integer index."
msgstr "カテゴリ変数です。内部では整数インデックスとして格納されます。"
