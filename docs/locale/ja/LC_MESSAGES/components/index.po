msgstr "ParentSelection"

#: ../../../components/index.md:185
msgid "Parent-selection schemes such as tournament and roulette-wheel selection."
msgstr "トーナメント選択やルーレット選択などの親選択方式。"

#: ../../../components/index.md:188
msgid "SurvivorSelection"
msgstr "SurvivorSelection"

