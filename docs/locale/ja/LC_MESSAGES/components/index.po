msgid "Where the surrogate's training data comes from, and with which labels."
msgstr "サロゲートの学習データをどこから、どのラベルで抽出するか。"

#: ../../../components/index.md:223
msgid "AcquisitionFunction"
msgstr "AcquisitionFunction"

#: ../../../components/index.md:227
msgid "Scores candidates from the surrogate's predictions."
msgstr "サロゲートの予測値から候補解をスコアリングします。"

#: ../../../components/index.md:230
msgid "AccuracyBasedSurrogateSwitcher"
msgstr "AccuracyBasedSurrogateSwitcher"

#: ../../../components/index.md:234
