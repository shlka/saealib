msgstr "`register(event_type, func)`"

#: ../../../components/callbacks.md
msgid ""
"Registers `func(event)` to be called every time an event of `event_type` "
"fires"
msgstr "`event_type`のイベントが発火するたびに`func(event)`を呼ぶよう登録する"

#: ../../../components/callbacks.md
msgid "`dispatch(event)`"
msgstr "`dispatch(event)`"

#: ../../../components/callbacks.md
msgid "Calls every registered handler, in registration order"
msgstr "登録済みの全ハンドラを登録順に呼ぶ"

#: ../../../components/callbacks.md
msgid "`unregister(event_type, func)`"
msgstr "`unregister(event_type, func)`"

#: ../../../components/callbacks.md
msgid "Removes a registered handler"
msgstr "登録済みハンドラを削除する"

