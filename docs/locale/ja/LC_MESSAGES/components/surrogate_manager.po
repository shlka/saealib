msgid "`eps=1.0`"
msgstr "`eps=1.0`"

#: ../../components/surrogate_manager.md
msgid "The reciprocal of the ε-neighborhood density"
msgstr "ε近傍密度の逆数（疎な領域を優先）"

#: ../../components/surrogate_manager.md
msgid "`MaximinDistanceAcquisition`"
msgstr "`MaximinDistanceAcquisition`"

