#, python-brace-format
msgid ""
"{py:class}`saealib.InequalityConstraint` / "
"{py:class}`saealib.EqualityConstraint`"
msgstr "{py:class}`saealib.InequalityConstraint` / {py:class}`saealib.EqualityConstraint`"

#: ../../../tutorials/constraints.md:121
#, python-brace-format
msgid "{py:class}`saealib.Problem`"
msgstr "{py:class}`saealib.Problem`"

#: ../../../tutorials/constraints.md:122
#, python-brace-format
msgid ""
"{py:class}`saealib.ConstraintHandler` / "
"{py:class}`saealib.StaticToleranceHandler` / "
"{py:class}`saealib.EpsilonConstraintHandler` / "
"{py:class}`saealib.GradientRepairHandler`"
msgstr "{py:class}`saealib.ConstraintHandler` / {py:class}`saealib.StaticToleranceHandler` / {py:class}`saealib.EpsilonConstraintHandler` / {py:class}`saealib.GradientRepairHandler`"

