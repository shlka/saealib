#: ../../../getting_started/installation.md:32
msgid "`torch`"
msgstr "`torch`"

#: ../../../getting_started/installation.md:32
msgid "PyTorch-based components"
msgstr "PyTorchベースのコンポーネント"

#: ../../../getting_started/installation.md:32
msgid "`pymoo`"
msgstr "`pymoo`"

#: ../../../getting_started/installation.md:32
msgid "`PymooCrossover`/`PymooMutation`/`PymooAlgorithm`/`PymooProblem` adapters"
msgstr "`PymooCrossover`/`PymooMutation`/`PymooAlgorithm`/`PymooProblem`アダプタ"

#: ../../../getting_started/installation.md:32
